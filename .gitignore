node_modules/
lib/
*.tsbuildinfo
coverage/
*.tgz
# `pnpm deploy:profile` keeps one `.bak` beside the tarball it refreshes, so the
# pre-deploy build stays recoverable. `*.tgz` alone does not cover it.
*.tgz.bak
# Local scratch diagnostics stay untracked, but the scripts the package's own
# commands depend on belong to the repo: `pnpm typecheck` runs typecheck-host,
# `pnpm check:readmes` runs check-readmes (so the README pair cannot drift), and
# `pnpm deploy:profile` automates the deploy step whose absence silently leaves
# DSH running an older build. A gated script that is never committed makes its
# own gate fail on a fresh clone.
scripts/*
!scripts/typecheck-host.mjs
!scripts/deploy-profile.mjs
!scripts/check-readmes.mjs

# pnpm 11 regenerates this placeholder stub on every install (its content is the
# instruction "set this to true or false", not a real setting), so it is noise,
# not configuration.
pnpm-workspace.yaml

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# env & logs
.env
.env.*
*.log